# Credenciais locais do SUPERUS. Nunca versionar o .env real.
SUPERUS_USERNAME=
SUPERUS_PASSWORD=

# Opcionais. Se vazios, usa C:\Superus\Launcher.exe e C:\Superus\Superus.exe.
SUPERUS_LAUNCHER_PATH=
SUPERUS_EXECUTABLE_PATH=

# Barra do TFormPreview. Defaults comprovados na barra atual:
# XLS=409, HTM=437, PDF=465 (centro aproximado dos ícones).
SUPERUS_EXPORT_HTML_X=437
SUPERUS_EXPORT_HTML_Y=16

SUPERUS_PREVIEW_TIMEOUT=90
SUPERUS_SAVE_TIMEOUT=20
SUPERUS_FILE_TIMEOUT=60

# Supabase — somente backend.
# Nunca use a publishable/anon key para gravar.
SUPABASE_URL=
SUPABASE_SECRET_KEY=sb_secret_COLE_A_SECRET_KEY_DO_BACKEND_AQUI
# Alternativa compatível: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LOSS_TABLE=loss_period_snapshots
SUPABASE_SALES_TABLE=superus_period_snapshots
SUPABASE_TIMEOUT=30

# IMPORTANTE V8.1:
# Nao use sb_publishable_... / anon / SUPABASE_KEY para sincronizacao.
# Legacy SUPABASE_SERVICE_ROLE_KEY (JWT service_role) continua suportada.
# Análise com IA (Gemini, usada somente pelo backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=35
