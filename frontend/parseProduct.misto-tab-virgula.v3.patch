+function cleanDelimitedPart(value) {
+  return String(value || '')
+    .trim()
+    .replace(/^[,\s]+|[,\s]+$/g, '')
+    .replace(/\s+/g, ' ')
+}
+
+function parseCommaColumns(value) {
+  return String(value || '')
+    .split(/\s*,\s*/)
+    .map(cleanDelimitedPart)
+    .filter(Boolean)
+}
+
+function buildDelimitedProduct(parts) {
+  const cleaned = parts.map(cleanDelimitedPart).filter((part) => part !== '')
+  if (cleaned.length < 3) return null
+
+  // Preço fica sempre no final. "—" é aceito como preço ausente.
+  const last = cleaned.at(-1) || ''
+  const hasPrice = PRICE_OR_EMPTY_PATTERN.test(last)
+  const price = hasPrice ? normalizeParsedPrice(last) : ''
+  const withoutPrice = hasPrice ? cleaned.slice(0, -1) : cleaned
+
+  if (withoutPrice.length < 2) return null
+
+  // Gramatura é procurada de trás para frente. Isso evita confundir
+  // números de complemento como "18 Anos" ou "Old No. 7".
+  let unitIndex = -1
+  for (let index = withoutPrice.length - 1; index >= 0; index -= 1) {
+    if (UNIT_PATTERN.test(withoutPrice[index])) {
+      unitIndex = index
+      break
+    }
+  }
+  if (unitIndex < 0) return null
+
+  const unit = withoutPrice[unitIndex]
+  const textParts = withoutPrice.slice(0, unitIndex)
+  if (!textParts.length) return null
+
+  // 3 campos textuais: descrição, subdescrição/marca e complemento.
+  // Com apenas 2 campos, o segundo é subdescrição.
+  // Campos extras no meio pertencem ao complemento e são reunidos.
+  const description = textParts[0] || ''
+  const subdescription = textParts[1] || ''
+  const complement = textParts.slice(2).join(' ').trim()
+
+  return {
+    description,
+    subdescription,
+    complement,
+    unit,
+    price,
+  }
+}
